  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Log in as student",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the token so the other requests can send it as {{token}}.",
                  "const body = pm.response.json();",
                  "if (body.success) {",
                  "  pm.environment.set(\"token\", body.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"akosua@example.com\",\n  \"password\": \"Demo1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Purpose: Log in as a student. Returns a token that the other requests send automatically.\n\nAccess: Public. Limited to 20 sign-up or login attempts per 15 minutes per IP address.\n\nBody (JSON):\n- `email` (required)\n- `password` (required)\n\nThe seeded students are akosua@example.com, kojo@example.com and esi@example.com. Every seeded account uses the password `Demo1234`.\n\nParameters: none.\n\nThis request saves the returned token as `{{token}}`."
          },
